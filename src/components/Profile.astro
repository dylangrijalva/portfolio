  }

  .scroll-signal {
    bottom: auto;
    height: min(46vh, 380px);
    pointer-events: none;
    position: fixed;
    right: clamp(10px, 2.2vw, 28px);
    top: 104px;
    width: 22px;
    z-index: 10;
  }

  .scroll-signal__rail {
    background: color-mix(in srgb, var(--color-border) 82%, transparent);
    height: 100%;
    margin: 0 auto;
    position: relative;
    width: 1px;
  }

  .scroll-signal__runner {
    align-items: center;
    background: var(--color-accent);
    border: 1px solid var(--color-text);
    border-radius: 4px;
    display: flex;
    height: 18px;
    justify-content: center;
