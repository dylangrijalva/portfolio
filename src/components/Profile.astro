---
const email = "dilan.grijalva@outlook.com";

const evidence = [
  {
    label: "01",
    title: "Current focus",
    body: "React Native and Kotlin app work, Node.js services, and the details that keep a product from feeling brittle.",
  },
  {
    label: "02",
    title: "Working stack",
    body: "Node.js, .NET, Kotlin, React, React Native, Go, MySQL, Java, PostgreSQL, AWS, and Azure. I like moving between screens, APIs, and database code.",
  },
  {
    label: "03",
    title: "Why the page is short",
    body: "I do not want to pad this with fake case studies. Until I have work worth publishing, this stays direct.",
  },
];

const stack = [
  "TypeScript",
  "Node.js",
  ".NET",
  "Kotlin",
  "React",
  "React Native",
  "Go",
  "MySQL",
  "Java",
  "PostgreSQL",
  "AWS",
  "Azure",
];

const principles = [
  "Leave code easier to trace than I found it.",
  "Name the tradeoffs instead of hiding them.",
  "Fix the small product details that make software feel rough.",
];

const heatmapWeeks = 14;
const heatmapCellsPerWeek = 7;
const heatmapSeed = (value) => Math.sin(value * 127.1 + 311.7) * 43758.5453123;

const today = new Date();
const heatmapStart = new Date(today);
heatmapStart.setDate(today.getDate() - heatmapWeeks * heatmapCellsPerWeek + 1);
const heatmapLeadingDays = heatmapStart.getDay();

const heatmapDays = [
  ...Array.from({ length: heatmapLeadingDays }).map(() => ({ type: "padding" })),
  ...Array.from({ length: heatmapWeeks * heatmapCellsPerWeek }).map((_, index) => {
    const date = new Date(heatmapStart);
    date.setDate(heatmapStart.getDate() + index);
    const dayOfWeek = date.getDay();
    const dayValue = date.getTime() / 86_400_000;
    const noise = Math.abs(heatmapSeed(dayValue) % 1);
    const weekendScale = dayOfWeek === 0 || dayOfWeek === 6 ? 0.72 : 1;
    const level = Math.max(
      0,
      Math.min(4, Math.floor(noise * 4.6 * weekendScale + Math.sin((index + 3) / 9))),
    );

    return {
      type: "day",
      iso: date.toISOString().slice(0, 10),
      label: date.toLocaleDateString("en-US", { month: "short", day: "numeric" }),
      level,
      delay: index * 65,
    };
  }),
];
