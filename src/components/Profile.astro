      <a href="#principles">Principles</a>
      <a href={`mailto:${email}`}>Email</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="profile-title">
      <div class="hero-copy">
        <p class="eyebrow">Software developer · Managua, Nicaragua</p>
