      </div>

      <div class="stack-block" aria-label="Technology stack">
        <p class="stack-label">Tools I reach for</p>
        <ul class="stack-list">
          {stack.map((item) => <li class="scroll-reveal">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="content-section heatmap-section" id="activity" aria-labelledby="activity-title">
      <div class="section-heading">
        <h2 id="activity-title">Activity rhythm</h2>
        <p>Animated calendar heatmap based on a compact, deterministic pattern used to show activity cadence in the last few weeks.</p>
      </div>
      <p class="calendar-heatmap__caption">
        Sunday starts each column; squares pulse in subtle orange accents to read like a living timeline.
      </p>
      <div class="calendar-heatmap" role="img" aria-label="Calendar heatmap of activity">
        {
          heatmapDays.map((day) =>
            day.type === "padding" ? (
              <span class="calendar-heatmap__cell calendar-heatmap__cell--padding" aria-hidden="true"></span>
            ) : (
              <span
                class={`calendar-heatmap__cell calendar-heatmap__cell--level-${day.level}`}
                style={`--cell-delay: ${day.delay}ms`}
                title={`${day.label}: level ${day.level}`}
                aria-label={`${day.iso}: activity level ${day.level}`}
              ></span>
            ),
          )
        }
      </div>
      <p class="calendar-heatmap__legend">
        <span>Low</span>
        <span class="calendar-heatmap__swatch calendar-heatmap__swatch--0" aria-hidden="true"></span>
        <span class="calendar-heatmap__swatch calendar-heatmap__swatch--2" aria-hidden="true"></span>
        <span class="calendar-heatmap__swatch calendar-heatmap__swatch--4" aria-hidden="true"></span>
        <span>High</span>
      </p>
    </section>

    <section
      class="content-section principles-section"
      id="principles"
      aria-labelledby="principles-title"
    >
      <div class="section-heading">
        <h2 id="principles-title">Principles</h2>
        <p>
          The habits I care about are not complicated. They mostly come down to
          clarity, honest tradeoffs, and noticing where the product feels off.
        </p>
      </div>

      <div class="principles-layout">
        <ol class="principles-list">
          {principles.map((item) => <li class="scroll-reveal">{item}</li>)}
        </ol>

        <aside class="contact-panel scroll-reveal" aria-label="Contact">
          <p class="item-label">Useful on</p>
          <p>
            React, React Native, Node.js, .NET, Kotlin, Go, Java, MySQL,
            PostgreSQL, AWS, Azure, and backend-heavy product work where the
            implementation details matter.
          </p>
          <a href={`mailto:${email}`}>{email}</a>
        </aside>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>Dilan Grijalva</span>
    <a href={`mailto:${email}`}>{email}</a>
  </footer>
</div>

<div class="scroll-signal" aria-hidden="true">
  <div class="scroll-signal__rail">
    <div class="scroll-signal__runner"><span></span></div>
  </div>
</div>

<script>
  const root = document.documentElement;
  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const revealItems = Array.from(document.querySelectorAll(".scroll-reveal"));

  if (!motionQuery.matches && revealItems.length > 0) {
    root.classList.add("supports-scroll-reveal");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.2 },
    );

    revealItems.forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${Math.min(index, 7) * 45}ms`);
      observer.observe(item);
    });
  }

  let scrollFrame = 0;

  const updateScrollSignal = () => {
    const page = document.documentElement;
    const maxScroll = Math.max(1, page.scrollHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
    const wobble = Math.sin(progress * Math.PI * 10);

    root.style.setProperty("--scroll-progress", progress.toFixed(4));
    root.style.setProperty("--scroll-y", `${(progress * 100).toFixed(2)}%`);
    root.style.setProperty("--signal-bob", `${(wobble * 3).toFixed(2)}px`);
    root.style.setProperty("--signal-tilt", `${(wobble * 11).toFixed(2)}deg`);
    scrollFrame = 0;
  };

  const requestScrollSignal = () => {
    if (scrollFrame === 0) {
      scrollFrame = window.requestAnimationFrame(updateScrollSignal);
    }
  };

  updateScrollSignal();
  window.addEventListener("scroll", requestScrollSignal, { passive: true });
  window.addEventListener("resize", requestScrollSignal);
</script>

