---
import SiteHeader from "./SiteHeader.astro";
import HeroSection from "./HeroSection.astro";
import FocusSection from "./FocusSection.astro";
import PrinciplesSection from "./PrinciplesSection.astro";
import BlogSection from "./BlogSection.astro";
import SiteFooter from "./SiteFooter.astro";
import SectionNavigation from "./SectionNavigation.astro";
---

<div class="site-shell">
  <SiteHeader />

  <main>
    <HeroSection />
    <FocusSection />
    <PrinciplesSection />
    <BlogSection />
  </main>

  <SiteFooter />
</div>

<SectionNavigation />

<style>
  .site-shell {
    width: min(1120px, calc(100% - clamp(32px, 8vw, 96px)));
    margin: 0 auto;
    padding: 0 0 40px;
  }

  @media (min-width: 1120px) {
    .site-shell {
      width: min(960px, calc(100% - 320px));
    }
  }

  @media (max-width: 780px) {
    .site-shell {
      width: min(100% - 32px, 1120px);
    }
  }

  @media (max-width: 520px) {
    .site-shell {
      width: min(100% - 24px, 1120px);
    }
  }
</style>
