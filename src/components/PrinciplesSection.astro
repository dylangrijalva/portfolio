---
import { principles, email } from "../data/profile";
---

<section
  class="content-section principles-section"
  id="principles"
  aria-labelledby="principles-title"
>
  <div class="section-heading">
    <h2 id="principles-title">Principles</h2>
    <p>
      The habits I care about are not complicated. They mostly come down to
      clarity, honest tradeoffs, and noticing where the product feels off.
    </p>
  </div>

  <div class="principles-layout">
    <ul class="principles-list">
      {principles.map((item) => <li>{item}</li>)}
    </ul>

    <aside class="contact-panel" aria-label="Contact">
      <p class="item-label">Useful on</p>
      <p>
        React, React Native, Node.js, .NET, Kotlin, Go, Java, MySQL, PostgreSQL,
        AWS, Azure, and backend-heavy product work where the implementation details
        matter.
      </p>
      <a href={`mailto:${email}`}>{email}</a>
    </aside>
  </div>
</section>

<style>
  .content-section {
    border-bottom: 1px solid var(--color-border);
    padding: clamp(48px, 8vw, 88px) 0;
    animation: rise-in 520ms ease both;
    animation-delay: 120ms;
  }

  .section-heading {
    display: grid;
    gap: 24px;
    grid-template-columns: 160px minmax(0, 1fr);
  }

  h2,
  p {
    margin-top: 0;
  }

  h2 {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
    margin-bottom: 0;
    text-transform: uppercase;
  }

  .section-heading p {
    font-size: clamp(24px, 3.4vw, 38px);
    font-weight: 560;
    line-height: 1.18;
    margin-bottom: 0;
    max-width: 850px;
  }

  .item-label {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0;
  }

  .principles-layout {
    display: grid;
    gap: clamp(36px, 7vw, 88px);
    grid-template-columns: minmax(0, 1fr) minmax(240px, 330px);
    margin-top: 46px;
  }

  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .principles-list li {
    border-top: 1px solid var(--color-border);
    display: grid;
    font-size: clamp(19px, 2.3vw, 25px);
    gap: 0;
    line-height: 1.35;
    grid-template-columns: minmax(0, 1fr);
    padding: 22px 0;
  }

  .principles-list li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .contact-panel {
    border-bottom: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    padding: 18px 0 20px;
  }

  .contact-panel p {
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 0;
  }

  .contact-panel a {
    display: inline-block;
    font-weight: 650;
    margin-top: 18px;
    overflow-wrap: anywhere;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: color 180ms ease;
  }

  .contact-panel a:hover {
    text-decoration-color: var(--color-text);
  }

  @media (max-width: 780px) {
    .section-heading,
    .principles-layout {
      grid-template-columns: 1fr;
    }

    .principles-layout {
      margin-top: 34px;
    }
  }

  @media (max-width: 520px) {
    .section-heading p {
      font-size: clamp(22px, 7.5vw, 30px);
    }

    .principles-list li {
      gap: 0;
    }
  }
</style>
