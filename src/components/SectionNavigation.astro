---
const navItems = [
  { href: "#intro", id: "intro", label: "Introduction" },
  { href: "#focus", id: "focus", label: "Focus" },
  { href: "#principles", id: "principles", label: "Principles" },
  { href: "#blog", id: "blog", label: "Blog" },
  { href: "#contact", id: "contact", label: "Contact" },
];
---

<nav class="section-nav" aria-label="Page sections" data-section-nav>
  <div class="section-nav__rail" aria-hidden="true"></div>
  <ul>
    {
      navItems.map((item, index) => (
        <li>
          <a
            href={item.href}
            data-section-link={item.id}
            aria-current={index === 0 ? "true" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const sectionNav = document.querySelector("[data-section-nav]");

  if (sectionNav) {
    const links = Array.from(
      sectionNav.querySelectorAll("[data-section-link]"),
    );
    const sections = links
      .map((link) => {
        const id = link.getAttribute("data-section-link");
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);
    let activeFrame = 0;

    const setActiveSection = (id: string) => {
      links.forEach((link) => {
        const isActive = link.getAttribute("data-section-link") === id;

        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const updateActiveSection = () => {
      const marker = window.scrollY + window.innerHeight * 0.38;
      const hashId = window.location.hash.slice(1);
      const visibleHashSection = sections.find((section) => {
        if (section.id !== hashId) {
          return false;
        }

        const rect = section.getBoundingClientRect();

        return rect.bottom > 0 && rect.top < window.innerHeight;
      });
      const activeSection =
        visibleHashSection ??
        sections.findLast((section) => section.offsetTop <= marker) ??
        sections[0];

      if (activeSection) {
        setActiveSection(activeSection.id);
      }

      activeFrame = 0;
    };

    const requestActiveSection = () => {
      if (activeFrame === 0) {
        activeFrame = window.requestAnimationFrame(updateActiveSection);
      }
    };

    links.forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.getAttribute("data-section-link");

        if (id) {
          setActiveSection(id);
        }
      });
    });

    updateActiveSection();
    window.requestAnimationFrame(updateActiveSection);
    window.addEventListener("scroll", requestActiveSection, { passive: true });
    window.addEventListener("resize", requestActiveSection);
    window.addEventListener("hashchange", requestActiveSection);
    window.addEventListener("load", requestActiveSection);
  }
</script>

<style>
  .section-nav {
    display: none;
  }
</style>
