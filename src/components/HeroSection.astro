---
import { email } from "../data/profile";
---

<section class="hero" id="intro" aria-labelledby="profile-title">
  <div class="hero-copy">
    <p class="eyebrow">Software developer · Managua, Nicaragua</p>
    <h1 id="profile-title">
      I build mobile and backend software that <em>holds up</em> in the real world.
    </h1>
    <p class="lede">
      I am Dilan, a software developer in Managua. I like working where product
      behavior meets the systems behind it: mobile flows, APIs, data models, and
      the small details users notice first.
    </p>
    <div class="hero-actions" aria-label="Contact and availability">
      <a class="email-button" href={`mailto:${email}`}>Start a conversation <span aria-hidden="true">→</span></a>
      <span class="availability">Available for focused engineering work</span>
    </div>
  </div>

  <figure class="portrait">
    <div class="portrait-bar" aria-hidden="true">
      <span></span><span></span><span></span>
      <small>profile — dagn.dev</small>
    </div>
    <div class="portrait-content">
      <img src="/images/dilan-grijalva.jpeg" alt="Dilan Grijalva portrait" />
      <figcaption>
        <span>&gt; location</span> Managua, Nicaragua<br />
        <span>&gt; focus</span> mobile + backend<br />
        <strong>available for the right work.</strong>
      </figcaption>
    </div>
  </figure>
</section>

<style>
  .hero {
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: clamp(36px, 8vw, 96px);
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    min-height: calc(100vh - 76px);
    padding: clamp(64px, 9vw, 112px) 0 clamp(68px, 9vw, 108px);
    animation: rise-in 520ms ease both;
  }

  .hero-copy {
    animation: rise-in 520ms ease both;
    animation-delay: 0ms;
  }

  .portrait {
    animation: rise-in 520ms ease both;
    animation-delay: 80ms;
    justify-self: end;
    margin: 0;
  }

  .eyebrow,
  .item-label,
  .stack-label {
    color: var(--color-muted);
    font-family: var(--font-mono);
    align-items: center;
    display: flex;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .eyebrow::before {
    background: var(--color-success);
    border-radius: 50%;
    content: "";
    height: 7px;
    margin-right: 10px;
    width: 7px;
  }

  h1,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.07;
    margin: 28px 0 26px;
    max-width: 760px;
  }

  h1 em {
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-weight: 400;
  }

  .lede {
    color: var(--color-muted);
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.55;
    margin-bottom: 32px;
    max-width: 670px;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 20px;
  }

  .email-button {
    align-items: center;
    background: var(--color-text);
    border: 1px solid var(--color-text);
    border-radius: 7px;
    color: var(--color-background);
    display: inline-flex;
    font-weight: 650;
    min-height: 54px;
    padding: 0 22px;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .email-button:hover {
    background: #dfc093;
    border-color: #dfc093;
    color: var(--color-ink);
    transform: translateY(-1px);
  }

  .availability {
    align-items: center;
    color: var(--color-muted);
    display: inline-flex;
    font-size: 14px;
    gap: 10px;
    max-width: 100%;
  }

  .availability::before {
    background: var(--color-accent);
    border-radius: 9999px;
    content: "";
    height: 7px;
    width: 7px;
  }

  .portrait {
    background:
      radial-gradient(circle at 70% 25%, rgba(201, 168, 124, 0.08), transparent 42%),
      #121211;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    width: 100%;
  }

  .portrait-bar {
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    gap: 7px;
    min-height: 46px;
    padding: 0 16px;
    position: relative;
  }

  .portrait-bar > span {
    background: #e0645a;
    border-radius: 50%;
    height: 10px;
    width: 10px;
  }

  .portrait-bar > span:nth-child(2) {
    background: #ddb44e;
  }

  .portrait-bar > span:nth-child(3) {
    background: #65b967;
  }

  .portrait-bar small {
    color: rgba(245, 240, 235, 0.35);
    font-family: var(--font-mono);
    font-size: 10px;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
  }

  .portrait-content {
    align-items: center;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(130px, 0.9fr) minmax(150px, 1.1fr);
    padding: clamp(22px, 4vw, 38px);
  }

  .portrait img {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    filter: saturate(0.72) contrast(1.04);
    object-fit: cover;
    width: 100%;
  }

  .portrait figcaption {
    color: rgba(245, 240, 235, 0.52);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 2;
    margin: 0;
  }

  .portrait figcaption span {
    color: var(--color-accent);
  }

  .portrait figcaption strong {
    color: var(--color-success);
    display: block;
    font-weight: 500;
    margin-top: 14px;
  }

  @media (max-width: 780px) {
    .hero {
      gap: 34px;
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 58px 0 64px;
    }

    h1 {
      font-size: clamp(42px, 10vw, 62px);
      margin-bottom: 22px;
    }

    .portrait {
      justify-self: start;
    }
  }

  @media (max-width: 520px) {
    .hero {
      gap: 28px;
      padding: 38px 0 44px;
    }

    h1 {
      font-size: clamp(34px, 11vw, 46px);
      line-height: 1.06;
    }

    .lede {
      font-size: 16px;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .email-button {
      justify-content: center;
      width: 100%;
    }

    .availability {
      align-items: flex-start;
      font-size: 13px;
      line-height: 1.45;
    }

    .availability::before {
      flex: 0 0 auto;
      margin-top: 6px;
    }

    .portrait-content {
      grid-template-columns: minmax(100px, 0.85fr) minmax(135px, 1.15fr);
      padding: 20px;
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
