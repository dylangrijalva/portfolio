---
import { email } from "../data/profile";
---

<section class="hero" id="intro" aria-labelledby="profile-title">
  <div class="hero-copy">
    <p class="eyebrow">Software developer · Managua, Nicaragua</p>
    <h1 id="profile-title">
      I build mobile and backend software with a practical, product-minded
      approach.
    </h1>
    <p class="lede">
      I am Dilan, a software developer in Managua. I am drawn to the work between
      product behavior and the systems behind it: mobile flows, APIs, data models,
      and the rough edges users actually notice.
    </p>
    <div class="hero-actions" aria-label="Contact and availability">
      <a class="email-button" href={`mailto:${email}`}>Contact by email</a>
      <span class="availability">Available for focused engineering work</span>
    </div>
  </div>

  <figure class="portrait">
    <img src="/images/dilan-grijalva.jpeg" alt="Dilan Grijalva portrait" />
    <figcaption>Based in Managua. Comfortable around app and API layers.</figcaption>
  </figure>
</section>

<style>
  .hero {
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: clamp(36px, 8vw, 96px);
    grid-template-columns: minmax(0, 1fr) minmax(180px, 260px);
    padding: clamp(56px, 10vw, 128px) 0 clamp(48px, 8vw, 88px);
    animation: rise-in 520ms ease both;
  }

  .hero-copy {
    animation: rise-in 520ms ease both;
    animation-delay: 0ms;
  }

  .portrait {
    animation: rise-in 520ms ease both;
    animation-delay: 80ms;
    justify-self: end;
    margin: 0;
  }

  .eyebrow,
  .item-label,
  .stack-label {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0;
  }

  h1,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: clamp(40px, 7vw, 76px);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.02;
    margin-bottom: 28px;
    max-width: 820px;
  }

  .lede {
    color: var(--color-muted);
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.55;
    margin-bottom: 32px;
    max-width: 670px;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 20px;
  }

  .email-button {
    align-items: center;
    background: var(--color-text);
    border: 1px solid var(--color-text);
    border-radius: 4px;
    color: var(--color-background);
    display: inline-flex;
    font-weight: 650;
    min-height: 46px;
    padding: 0 18px;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .email-button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  .availability {
    align-items: center;
    color: var(--color-muted);
    display: inline-flex;
    font-size: 14px;
    gap: 10px;
    max-width: 100%;
  }

  .availability::before {
    background: var(--color-accent);
    border-radius: 9999px;
    content: "";
    height: 7px;
    width: 7px;
  }

  .portrait img {
    aspect-ratio: 1;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    filter: saturate(0.92) contrast(1.02);
    object-fit: cover;
    width: clamp(168px, 22vw, 240px);
  }

  .portrait figcaption {
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.45;
    margin-top: 14px;
    max-width: 240px;
  }

  @media (max-width: 780px) {
    .hero {
      gap: 34px;
      grid-template-columns: 1fr;
      padding: 48px 0 52px;
    }

    h1 {
      font-size: clamp(38px, 12vw, 56px);
      margin-bottom: 22px;
    }

    .portrait {
      justify-self: start;
    }
  }

  @media (max-width: 520px) {
    .hero {
      gap: 28px;
      padding: 38px 0 44px;
    }

    h1 {
      font-size: clamp(34px, 11vw, 46px);
      line-height: 1.06;
    }

    .lede {
      font-size: 16px;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .email-button {
      justify-content: center;
      width: 100%;
    }

    .availability {
      align-items: flex-start;
      font-size: 13px;
      line-height: 1.45;
    }

    .availability::before {
      flex: 0 0 auto;
      margin-top: 6px;
    }

    .portrait img {
      width: min(72vw, 220px);
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
