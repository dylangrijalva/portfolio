---
import { evidenceItems, stackItems } from "../data/profile";
---

<section class="content-section" id="focus" aria-labelledby="focus-title">
  <div class="section-heading">
    <h2 id="focus-title">// current_focus</h2>
    <p>
      A quick read on the kind of engineering work I am trying to get better at
      right now.
    </p>
  </div>

  <div class="evidence-grid">
    {
      evidenceItems.map((item) => (
        <article class="evidence-item">
          <p class="item-label">{item.label}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))
    }
  </div>

  <div class="stack-block" aria-label="Technology stack">
    <p class="stack-label">Tools I reach for</p>
    <ul class="stack-list">
      {stackItems.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .content-section {
    background: var(--color-paper);
    box-shadow: 0 0 0 100vmax var(--color-paper);
    clip-path: inset(0 -100vmax);
    color: var(--color-ink);
    padding: clamp(72px, 10vw, 118px) 0;
    animation: rise-in 520ms ease both;
    animation-delay: 120ms;
  }

  .section-heading {
    display: grid;
    gap: 24px;
    grid-template-columns: 160px minmax(0, 1fr);
  }

  h2,
  p {
    margin-top: 0;
  }

  h2 {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.2;
    margin-bottom: 0;
    text-transform: uppercase;
  }

  .section-heading p {
    font-size: clamp(34px, 4.4vw, 54px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 0;
    max-width: 850px;
  }

  .item-label,
  .stack-label {
    color: var(--color-muted-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0;
  }

  .evidence-grid {
    display: grid;
    gap: clamp(24px, 4vw, 48px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 46px;
  }

  .evidence-item {
    border-top: 1px solid var(--color-border-dark);
    padding-top: 18px;
  }

  .evidence-item h3 {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.3;
    margin: 18px 0 10px;
  }

  .evidence-item p:last-child {
    color: var(--color-muted-ink);
    line-height: 1.65;
  }

  .stack-block {
    display: grid;
    gap: 24px;
    grid-template-columns: 160px minmax(0, 1fr);
    margin-top: 52px;
  }

  .stack-list {
    border-top: 1px solid var(--color-border-dark);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack-list li {
    border-bottom: 1px solid var(--color-border-dark);
    color: var(--color-ink);
    font-size: 15px;
    padding: 13px 0;
    margin: 0;
  }

  @media (max-width: 780px) {
    .section-heading,
    .stack-block {
      grid-template-columns: 1fr;
    }

    .evidence-grid,
    .stack-list {
      grid-template-columns: 1fr;
    }

    .evidence-grid {
      margin-top: 34px;
    }

    .stack-block {
      gap: 14px;
      margin-top: 40px;
    }
  }

  @media (max-width: 520px) {
    .section-heading p {
      font-size: clamp(22px, 7.5vw, 30px);
    }
  }
</style>
