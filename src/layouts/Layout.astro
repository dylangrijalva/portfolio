---
const siteUrl = "https://www.dagn.dev/";
const siteName = "Dilan Grijalva";
const title = "Dilan Grijalva | Software Developer in Managua";
const description =
  "Dilan Grijalva is a software developer in Managua working on mobile apps, backend services, and product details that make software feel reliable.";
const imageUrl = `${siteUrl}images/dilan-grijalva.jpeg`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: siteName,
      alternateName: "Dilan Grijalva Portfolio",
      inLanguage: "en",
      publisher: {
        "@id": `${siteUrl}#person`,
      },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: siteName,
      url: siteUrl,
      image: imageUrl,
      jobTitle: "Software Developer",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Managua",
        addressCountry: "NI",
      },
      knowsAbout: [
        "TypeScript",
        "Node.js",
        ".NET",
        "React",
        "React Native",
        "Go",
        "MySQL",
        "PostgreSQL",
        "Java",
        "Kotlin",
        "AWS",
        "Azure",
        "Backend development",
        "Mobile app development",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#171716" />
    <link rel="canonical" href={siteUrl} />
    <link type="image/png" sizes="32x32" rel="icon" href="/favicon.png" />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Portrait of Dilan Grijalva" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-background: #171716;
    --color-surface: #1d1d1b;
    --color-paper: #f2eee8;
    --color-text: #f5f0eb;
    --color-ink: #1a1a19;
    --color-muted: rgba(245, 240, 235, 0.62);
    --color-muted-ink: #6d6963;
    --color-border: rgba(245, 240, 235, 0.12);
    --color-border-dark: rgba(26, 26, 25, 0.16);
    --color-accent: #c9a87c;
    --color-accent-soft: rgba(201, 168, 124, 0.1);
    --color-success: #6bbb73;
    --font-sans: "DM Sans", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
    --font-serif: Georgia, "Times New Roman", serif;
    --font-mono: "SFMono-Regular", "Roboto Mono", "JetBrains Mono", Consolas,
      monospace;
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-synthesis-weight: none;
    text-rendering: optimizeLegibility;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-width: 320px;
    min-height: 100%;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--color-background);
    color: var(--color-text);
    overflow-x: hidden;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  ::selection {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
